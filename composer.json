{
  "name": "aporat/laravel-push-notifications",
  "description": "Laravel integration for aporat/push-notifications: APNs and FCM pushes per app, with events, a notification channel and a fake for tests",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/aporat/laravel-push-notifications",
  "keywords": [
    "laravel",
    "apns",
    "apple",
    "android",
    "fcm",
    "firebase",
    "ios",
    "push notifications"
  ],
  "authors": [
    {
      "name": "Adar Porat",
      "email": "aporat28@gmail.com",
      "homepage": "https://github.com/aporat",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "aporat/push-notifications": "^0.1",
    "laravel/framework": "^12.0 || ^13.0",
    "psr/cache": "^2.0 || ^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.21",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../push-notifications",
      "options": {
        "symlink": true,
        "versions": {
          "aporat/push-notifications": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Aporat\\PushNotifications\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aporat\\PushNotifications\\Laravel\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aporat\\PushNotifications\\Laravel\\PushNotificationsServiceProvider"
      ],
      "aliases": {
        "Push": "Aporat\\PushNotifications\\Laravel\\Facades\\Push"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-ci": "vendor/bin/phpunit --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
    "check": "vendor/bin/pint --test",
    "fix": "vendor/bin/pint",
    "analyze": "vendor/bin/phpstan analyse --memory-limit=-1"
  },
  "support": {
    "issues": "https://github.com/aporat/laravel-push-notifications/issues",
    "source": "https://github.com/aporat/laravel-push-notifications"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
